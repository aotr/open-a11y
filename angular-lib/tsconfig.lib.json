{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "outDir": "../dist/angular-out",
    "declaration": true,
    "declarationMap": false,
    "inlineSources": true,
    "types": []
  },
  "angularCompilerOptions": {
    "compilationMode": "partial",
    "strictInjectionParameters": true,
    "strictTemplates": true
  },
  "include": ["src/**/*.ts"]
}
